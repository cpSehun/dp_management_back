# 1. Python 3.11 공식 이미지를 베이스로 사용
FROM python:3.11-slim

# 2. 작업 디렉토리 설정
WORKDIR /app

# 3. 시스템 패키지 업데이트 및 필요한 라이브러리 설치 (MySQL 클라이언트 등)
#    build-essential: C 컴파일러 등 빌드 도구
#    default-libmysqlclient-dev: MySQL 클라이언트 라이브러리 (pymysql 컴파일 시 필요할 수 있음)
#    --no-install-recommends: 추천 패키지 제외하여 이미지 크기 줄임
#    apt-get clean && rm -rf /var/lib/apt/lists/*: 설치 후 캐시 정리
RUN apt-get update && \
    apt-get install -y --no-install-recommends default-libmysqlclient-dev build-essential && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 4. 가상 환경 생성 및 활성화 준비 (선택 사항이지만 권장)
#    venv를 사용하면 시스템 Python과 격리된 환경을 제공합니다.
#    Docker 이미지 내에서는 필수는 아니지만, 로컬 개발 환경과 일관성을 유지할 수 있습니다.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 5. requirements.txt 파일을 먼저 복사하고 패키지 설치
#    소스 코드가 변경되어도 이 단계는 캐시를 활용하여 빌드 속도를 높입니다.
COPY ./requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 6. 애플리케이션 코드 복사
#    '.'는 WORKDIR로 설정된 /app 디렉토리를 의미합니다.
COPY ./app /app/app

# 7. Gunicorn 실행 명령 설정
#    -w 4: 워커 프로세스 4개 사용 (CPU 코어 수에 맞게 조절)
#    -k uvicorn.workers.UvicornWorker: Uvicorn 워커 사용 (비동기 처리)
#    -b 0.0.0.0:8000: 모든 IP 주소의 8000번 포트에서 수신 대기
#    app.main:app: app/main.py 파일의 app 객체를 실행
#    --log-level info: 로깅 레벨 설정
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8000", "app.main:app", "--log-level", "info"]

# 8. 컨테이너가 리스닝할 포트 명시 (문서화 목적, 실제 포트 매핑은 docker-compose에서)
EXPOSE 8000
